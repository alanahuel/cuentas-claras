APP_DOMAIN=cuentas.tu-dominio.es

# Optional external document reading. Both values are required to enable it.
# Choose a model supporting vision, PDF input and Structured Outputs.
OPENAI_API_KEY=
DOCUMENT_AI_MODEL=

# App help assistant (independent from document reading). Empty model disables it.
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=20
ASSISTANT_MONTHLY_TOKENS=100000
ASSISTANT_GLOBAL_DAILY_LIMIT=200
ASSISTANT_GLOBAL_MONTHLY_TOKENS=1000000
